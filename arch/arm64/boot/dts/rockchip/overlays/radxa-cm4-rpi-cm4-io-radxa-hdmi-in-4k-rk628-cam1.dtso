/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/power/rockchip,rk3576-power.h>

/ {
	metadata {
		title = "Enable Radxa HDMI IN to MIPI CSI-2 Adapter on CAM1 (4-lane)";
		compatible = "radxa,cm4-rpi-cm4-io";
		category = "camera";
		exclusive = "GPIO2_C5", "csi2_dphy3", "i2c0";
		description = "Enable Radxa 4K HDMI IN to MIPI CSI-2 Adapter on the CAM1 4-lane CSI connector.
Supports up to 3840x2160 at 30 fps.
To capture audio, also enable the 'SAI2-M0 capture-only dummy sound card' overlay.";
	};
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m1_xfer>;
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	rk628_csi2: rk628-csi@50 {
		compatible = "rockchip,rk628-csi-v4l2";
		reg = <0x50>;
		power-domains = <&power RK3576_PD_VI>;
		pinctrl-names = "default";
		pinctrl-0 = <&rk628_cam1_reset>;
		/* INT and DET are not routed; the driver uses I2C polling. */
		reset-gpios = <&gpio2 RK_PC5 GPIO_ACTIVE_LOW>;
		continues-clk = <1>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "HDMI-MIPI1";
		rockchip,camera-module-lens-name = "RK628-CSI";

		port {
			hdmiin_out1: endpoint {
				remote-endpoint = <&hdmi2mipi_in1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0_hw {
	status = "okay";
};

&csi2_dphy1_hw {
	status = "okay";
};

&csi2_dphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi2mipi_in1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&hdmiin_out1>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi3_input>;
			};
		};
	};
};

&mipi3_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi3_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi3_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds3 {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi_csi3_output>;
		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&pinctrl {
	hdmiin-cam1 {
		rk628_cam1_reset: rk628-cam1-reset {
			rockchip,pins = <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
