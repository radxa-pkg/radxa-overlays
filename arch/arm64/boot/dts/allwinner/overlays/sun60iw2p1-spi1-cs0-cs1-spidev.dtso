/dts-v1/;
/plugin/;

#include <dt-bindings/spi/sunxi-spi.h>

/ {
	metadata {
		title = "Enable dual-CS spidev on SPI1";
		compatible = "radxa,cm-a7-rpi-cm5-io";
		category = "misc";
		exclusive = "spi1", "PD10", "PD11", "PD12", "PD13", "PD15";
		description = "Enable SPI1 MOSI/MISO/CLK on physical pins 19/21/23 and native CS0/CS1 on physical pins 24/26.";
	};
};

&pio {
	spi1_pins_default: spi1-pins-default {
		pins = "PD11", "PD12", "PD13";
		function = "spi1";
		drive-strength = <10>;
	};

	spi1_pins_cs: spi1-pins-cs {
		pins = "PD10", "PD15";
		function = "spi1";
		drive-strength = <10>;
		bias-pull-up;
	};

	spi1_pins_sleep: spi1-pins-sleep {
		pins = "PD10", "PD11", "PD12", "PD13", "PD15";
		function = "gpio_in";
		drive-strength = <10>;
	};
};

&spi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <50000000>;
	pinctrl-0 = <&spi1_pins_default &spi1_pins_cs>;
	pinctrl-1 = <&spi1_pins_sleep>;
	pinctrl-names = "default", "sleep";
	sunxi,spi-num-cs = <2>;
	sunxi,spi-bus-mode = <SUNXI_SPI_BUS_MASTER>;
	sunxi,spi-cs-mode = <SUNXI_SPI_CS_AUTO>;
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;
		status = "okay";
	};

	spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;
		status = "okay";
	};
};
