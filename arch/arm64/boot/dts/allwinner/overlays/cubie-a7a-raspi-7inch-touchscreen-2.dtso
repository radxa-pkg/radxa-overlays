/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/display/sunxi-lcd.h>

/* This standard DSI flag is not defined in sunxi-lcd.h. */
#define MIPI_DSI_MODE_LPM (1 << 11)

/ {
	metadata {
		title = "Enable Raspberry Pi 7-inch Display 2";
		compatible = "radxa,cubie-a7a";
		category = "display";
		exclusive = "dlcd0", "dsi0", "dsi0combophy", "twi2",
			    "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9",
			    "PD16", "PD17";
		description = "Enable Raspberry Pi 7-inch Display 2.
Connect DSI0 and supply the display with 5V.";
	};
};

&{/} {
	rpi7_v2_backlight: backlight-rpi7-v2 {
		compatible = "pwm-backlight";
		pwms = <&rpi7_v2_mcu 0 255 0>;
		brightness-levels = <0 31>;
		num-interpolated-steps = <31>;
		default-brightness-level = <31>;
	};

	rpi7_v2_touch_power: regulator-rpi7-v2-touch {
		compatible = "regulator-fixed";
		regulator-name = "rpi7-v2-touch";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_dc1sw1>;
		gpio = <&rpi7_v2_mcu 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <50000>;
	};
};

&dsi0combophy {
	status = "okay";
};

&dlcd0 {
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&dsi0_4lane_pins_a>;
	pinctrl-1 = <&dsi0_4lane_pins_b>;
	pinctrl-names = "active", "sleep";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			rpi7_v2_dsi_out: endpoint {
				remote-endpoint = <&rpi7_v2_panel_input>;
			};
		};
	};

	rpi7_v2_panel: panel@0 {
		compatible = "allwinner,virtual-panel";
		reg = <0>;
		status = "okay";
		power-num = <2>;
		power0-supply = <&reg_dc1sw1>;
		power1-supply = <&reg_bldo2>;
		power-delay-ms = <5>;
		gpio-num = <0>;
		reset-gpios = <&rpi7_v2_mcu 0 GPIO_ACTIVE_LOW>;
		reset-on-sequence = <1 20 0 20>;
		reset-off-sequence = <1 20>;
		backlight = <&rpi7_v2_backlight>;
		width-mm = <90>;
		height-mm = <151>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM)>;
		dsi,lanes = <2>;
		dsi,format = <0>;

		/* Raspberry Pi panel-ilitek-ili9881c: rpi_7inch_init and prepare. */
		panel-init-sequence = [
			39 00 04 FF 98 81 03
			15 00 02 01 00
			15 00 02 02 00
			15 00 02 03 73
			15 00 02 04 00
