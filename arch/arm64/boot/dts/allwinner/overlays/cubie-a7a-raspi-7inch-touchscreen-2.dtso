		display-timings {
			native-mode = <&rpi7_v2_timing>;

			rpi7_v2_timing: timing0 {
				clock-frequency = <83330000>;
				hactive = <720>;
				vactive = <1280>;
				hsync-len = <33>;
				hback-porch = <50>;
				hfront-porch = <239>;
				vsync-len = <2>;
				vback-porch = <30>;
				vfront-porch = <20>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			rpi7_v2_panel_input: endpoint {
				remote-endpoint = <&rpi7_v2_dsi_out>;
			};
		};
	};
};

&twi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-0 = <&twi2_pins_default>;
	pinctrl-1 = <&twi2_pins_sleep>;
	pinctrl-names = "default", "sleep";
	twi_drv_used = <0>;
	no_suspend = <1>;
	twi-supply = <&reg_bldo2>;
	status = "okay";

	rpi7_v2_mcu: regulator@45 {
		compatible = "raspberrypi,touchscreen-panel-regulator-v2";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
		#pwm-cells = <3>;
	};

	/* The Goodix driver polls when no interrupt is provided. */
	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		AVDD28-supply = <&rpi7_v2_touch_power>;
		touchscreen-size-x = <720>;
		touchscreen-size-y = <1280>;
		status = "okay";
	};
};

&pio {
	twi2_pins_default: twi2@0 {
		pins = "PD16", "PD17";
		function = "twi2";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi2_pins_sleep: twi2@1 {
		pins = "PD16", "PD17";
		function = "gpio_in";
	};
};
