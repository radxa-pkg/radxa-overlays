/dts-v1/;
/plugin/;

#include "qcs6490-radxa-dragon-q6a-camx-common.dtsi"

/ {
	metadata {
		title = "Enable CAM1 + CAM2 + CAM3 on Qualcomm CAMX hardware ISP";
		compatible = "radxa,dragon-q6a";
		category = "camera";
		exclusive = "cci0", "cci1", "camss", "camx-isp", "cci0_i2c0", "cci1_i2c0", "cci1_i2c1";
		description = "Enable CAM1 (slot 12, CSIPHY0, CCI0 master 0),
CAM2 (two-lane, slot 8, CSIPHY2, CCI1 master 0) and
CAM3 (two-lane, slot 0, CSIPHY3, CCI1 master 1) together on the Qualcomm CAMX hardware ISP.
CAM2 and CAM3 use module-local 24 MHz oscillators.
Self-contained: this single overlay carries the shared CAMX infrastructure and every sensor node;
do not enable other CAMX or CAMSS camera overlays at the same time.
The sensor model is selected by sensor module bins matching slots 12, 8 and 0.";
	};
};

/* CAM1: CSIPHY0, CCI0 master 0, MCLK0 (GPIO64), reset GPIO20.
 * The sensor module bin selects sensor identification and operating modes. */
&cam_cci0 {
	qcom,cam-sensor12 {
		compatible = "qcom,cam-sensor";
		cell-index = <12>;
		csiphy-sd-index = <0>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&vreg_l6b_1p2>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		rgltr-min-voltage = <1200000>;
		rgltr-max-voltage = <1200000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active &cam_sensor_active_rst0>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend &cam_sensor_suspend_rst0>;
		gpios = <&tlmm 64 0>, <&tlmm 20 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAM_MCLK0", "CAM_RESET0";
		sensor-mode = <0>;
		cci-master = <0>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};

&{/} {
	/* CAM2 modules also supply their own 24 MHz INCK. */
	cam2_xclk: cam2-xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "cam2_xclk";
	};

	/* CAM3 modules also supply their own 24 MHz INCK. */
	cam3_xclk: cam3-xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "cam3_xclk";
	};
};

/* CAM2: CSIPHY2, CCI1 master 0, module-local 24 MHz clock, reset GPIO77.
 * The sensor module bin for slot 8 must match the installed module, including
 * its 24 MHz INCK. */
&cam_cci1 {
	qcom,cam-sensor8 {
		compatible = "qcom,cam-sensor";
		cell-index = <8>;
		csiphy-sd-index = <2>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&vreg_l18b_1p8>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		pwm-switch;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_active_rst2>;
		pinctrl-1 = <&cam_sensor_suspend_rst2>;
		gpios = <&tlmm 77 0>;
		gpio-reset = <0>;
		gpio-req-tbl-num = <0>;
		gpio-req-tbl-flags = <0>;
		gpio-req-tbl-label = "CAM_RESET2";
		sensor-mode = <0>;
		cci-master = <0>;
		clocks = <&cam2_xclk>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};

	qcom,cam-sensor0 {
		compatible = "qcom,cam-sensor";
		cell-index = <0>;
		csiphy-sd-index = <3>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&vreg_l18b_1p8>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		pwm-switch;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_active_rst3>;
		pinctrl-1 = <&cam_sensor_suspend_rst3>;
		gpios = <&tlmm 78 0>;
		gpio-reset = <0>;
		gpio-req-tbl-num = <0>;
		gpio-req-tbl-flags = <0>;
		gpio-req-tbl-label = "CAM_RESET3";
		sensor-mode = <0>;
		cci-master = <1>;
		clocks = <&cam3_xclk>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};
