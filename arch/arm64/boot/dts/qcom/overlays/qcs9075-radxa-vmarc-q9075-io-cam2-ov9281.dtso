/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/qcom,sa8775p-camcc.h>

/ {
	metadata {
		title = "Enable OV9281 camera on CAM2";
		compatible = "radxa,vmarc-q9075-io";
		category = "camera";
		exclusive = "cam_cci0", "cci0", "gpio39", "gpio72", "gpio99";
		description = "Enable OV9281 camera on CAM2";
	};
};

&soc {
	cam_ov9281_vio: cam-ov9281-vio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_ov9281_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	qcom,cam-res-mgr {
		compatible = "qcom,cam-res-mgr";
		status = "ok";
		gpios-shared = <518 519 520 521>;
	};
};

&tlmm {
	cam0_ov9281_ctrl_default: cam0-ov9281-ctrl-default-state {
		pins = "gpio39", "gpio99";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cam0_ov9281_ctrl_suspend: cam0-ov9281-ctrl-suspend-state {
		pins = "gpio39", "gpio99";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&camcc {
	status = "okay";
};

&cci0 {
	status = "disabled";
};

&cam_cci0 {
	status = "okay";

	qcom,cam-sensor20 {
		cell-index = <20>;
		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <0>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&cam_ov9281_vio>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		pwm-switch;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active
			     &cam0_ov9281_ctrl_default>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend
			     &cam0_ov9281_ctrl_suspend>;
		gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>,
			<&tlmm 39 GPIO_ACTIVE_HIGH>,
			<&tlmm 99 GPIO_ACTIVE_HIGH>;
		gpio-reset = <1>;
		gpio-custom1 = <2>;
		gpio-req-tbl-num = <0 1 2>;
		gpio-req-tbl-flags = <1 0 0>;
		gpio-req-tbl-label = "CAM_MCLK0",
				     "CAMIF_RESET0",
				     "CAM_CUSTOM1";
		cci-master = <0>;
		cci-device = <0>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};
